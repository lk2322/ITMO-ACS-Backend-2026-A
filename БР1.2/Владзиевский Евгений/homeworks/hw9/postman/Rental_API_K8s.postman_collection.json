    {
      "name": "4. Поиск и фильтрация",
      "item": [
        {
          "name": "Все объекты",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/properties",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "properties"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenant_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"есть созданный объект\", () => {",
                  "    const ids = pm.response.json().items.map(p => p.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"property_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Фильтр по городу",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/properties?city={{search_city}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "properties"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "{{search_city}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenant_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"все найденные — из нужного города\", () => {",
                  "    const city = pm.collectionVariables.get(\"search_city\");",
                  "    pm.response.json().items.forEach(p => pm.expect(p.city).to.eql(city));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Фильтр по цене",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/properties?min_price=1000&max_price=10000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "properties"
              ],
              "query": [
                {
                  "key": "min_price",
                  "value": "1000"
                },
                {
                  "key": "max_price",
                  "value": "10000"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenant_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"цены в заданном диапазоне\", () => {",
                  "    pm.response.json().items.forEach(p => {",
                  "        pm.expect(p.price_per_day).to.be.at.least(1000);",
                  "        pm.expect(p.price_per_day).to.be.at.most(10000);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Бронирование и оплата",
      "item": [
        {
          "name": "Забронировать объект",
          "request": {
            "method": "POST",
            "header": [
              {
