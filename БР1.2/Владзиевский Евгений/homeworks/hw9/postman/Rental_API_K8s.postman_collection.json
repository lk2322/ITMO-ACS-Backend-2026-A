              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// даты бронирования — через неделю от текущей, на 6 суток",
                  "const start = new Date(Date.now() + 7 * 24 * 3600 * 1000);",
                  "const end = new Date(start.getTime() + 6 * 24 * 3600 * 1000);",
                  "pm.collectionVariables.set('start_date', start.toISOString());",
                  "pm.collectionVariables.set('end_date', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"создано в статусе pending\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.status).to.eql(\"pending\");",
                  "    pm.collectionVariables.set(\"rental_id\", b.id);",
                  "});",
                  "pm.test(\"сумма посчитана\", () => pm.expect(pm.response.json().total_price).to.be.above(0));"
                ]
              }
            }
