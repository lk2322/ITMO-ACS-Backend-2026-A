{
  "info": {
    "name": "Rental API — микросервисы (ЛР7, Kubernetes)",
    "description": "Сквозной сценарий работы с API сервиса аренды недвижимости, развёрнутого в кластере Kubernetes.\n\nЗапросы идут через API Gateway за Ingress. Сценарий покрывает регистрацию обеих ролей, публикацию объекта, поиск, бронирование, оплату, переписку и историю, а также негативные проверки авторизации и валидации.\n\nПеременные окружения — в файле Rental_API_K8s.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Доступность",
      "item": [
        {
          "name": "Health-check шлюза",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": []
            },
            "description": "Проверяет, что Ingress доводит запрос до API Gateway.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"сервис — api-gateway\", () => pm.expect(pm.response.json().service).to.eql(\"api-gateway\"));",
                  "pm.test(\"статус ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Регистрация и вход",
      "item": [
        {
          "name": "Регистрация владельца",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Владелец Тестовый\",\n  \"role\": \"owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// адреса уникальны для каждого прогона, иначе повторная регистрация вернёт 409",
                  "const stamp = Date.now();",
                  "if (!pm.collectionVariables.get('run_stamp')) {",
                  "    pm.collectionVariables.set('run_stamp', stamp);",
                  "    pm.collectionVariables.set('owner_email', `owner-${stamp}@example.com`);",
                  "    pm.collectionVariables.set('tenant_email', `tenant-${stamp}@example.com`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"выданы оба токена\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(b.refresh_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"роль owner\", () => pm.expect(pm.response.json().user.role).to.eql(\"owner\"));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"owner_token\", body.access_token);",
                  "pm.collectionVariables.set(\"owner_id\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация арендатора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Арендатор Тестовый\",\n  \"role\": \"tenant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"роль tenant\", () => pm.expect(pm.response.json().user.role).to.eql(\"tenant\"));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"tenant_token\", body.access_token);",
                  "pm.collectionVariables.set(\"tenant_id\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Повторная регистрация того же email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Email уникален: сервис должен отказать.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Дубликат\",\n  \"role\": \"tenant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"дубликат отклонён (409 или 400)\", () => pm.expect(pm.response.code).to.be.oneOf([400, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход арендатора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"access_token выдан\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\"));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"tenant_token\", body.access_token);",
                  "pm.collectionVariables.set(\"tenant_id\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход с неверным паролем",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"отказ 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Профиль текущего пользователя",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenant_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"это тот же пользователь\", () => {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"tenant_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Профиль без токена",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Защищённый эндпоинт обязан требовать JWT.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"отказ 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Справочники",
      "item": [
        {
          "name": "Типы недвижимости",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/property-types",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "property-types"
              ]
            },
            "description": "Справочник заполняется property-service при старте (SeedData).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{owner_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
