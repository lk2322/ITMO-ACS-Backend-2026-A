                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"справочник не пуст\", () => {",
                  "    const types = pm.response.json();",
                  "    pm.expect(types).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.collectionVariables.set(\"type_id\", types[0].id);",
                  "});"
                ]
