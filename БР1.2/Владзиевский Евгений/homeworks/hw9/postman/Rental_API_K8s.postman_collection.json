              "host": [
                "{{base_url}}"
              ],
              "path": [
                "amenities"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{owner_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 200\", () => pm.response.to.have.status(200));",
