    {
      "name": "3. Публикация объекта (владелец)",
      "item": [
        {
          "name": "Создать объект",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/properties",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "properties"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type_id\": {{type_id}},\n  \"title\": \"Двушка у метро\",\n  \"description\": \"Светлая квартира рядом с парком\",\n  \"price_per_day\": 3500,\n  \"city\": \"{{search_city}}\",\n  \"address\": \"Кронверкский проспект, 49\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{owner_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ответ — JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"объект принадлежит владельцу\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.owner_id).to.eql(Number(pm.collectionVariables.get(\"owner_id\")));",
                  "    pm.collectionVariables.set(\"property_id\", b.id);",
                  "});",
                  "pm.test(\"цена сохранена\", () => pm.expect(pm.response.json().price_per_day).to.eql(3500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать объект от арендатора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/properties",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "properties"
              ]
            },
            "description": "Роль tenant не имеет права публиковать объекты.",
